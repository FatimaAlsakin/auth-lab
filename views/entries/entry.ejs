<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('../partials/navbar') %>

    <h1>New Entry</h1>
    <form action="/entries/new" method="POST">
   
        <label for="title">Title</label>
        <input type="text" id="title" name="title">
        <br><br>
        <label for="entryBody">Entry</label>
        <br>
        <textarea id="entryBody" name="entryBody" ></textarea>
        <br><br>
        <input type="radio" id="isPublic" name="isPublic">
        <label for="isPublic">Public</label>
        <br><br>
        <button type="submit" class="primary">Save entry</button>

  </form>
</body>
</html>